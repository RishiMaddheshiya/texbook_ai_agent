# Copy this file to .env and paste your free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=your_free_api_key
GEMINI_MODEL=gemini-3.1-flash-lite

# Optional settings
# VERIFY_ANSWERS=true          # second "answer verifier" call per question (turn off to halve API usage)
